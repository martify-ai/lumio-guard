{
  "name": "lumio-guard-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lumio Guard v0 — local-first Chrome (Manifest V3) extension",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:test": "tsx scripts/build.ts --test-host-access --test-hooks --out dist-test",
    "build:hooks": "tsx scripts/build.ts --test-hooks --out dist-hooks",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && npm run build:test && npm run build:hooks && playwright test",
    "spike:capacity": "tsx scripts/spike-capacity.ts",
    "browsers:install": "node scripts/install-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "esbuild": "0.24.2",
    "selfsigned": "2.4.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
